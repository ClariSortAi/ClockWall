bin/
obj/
*.exe
*.pdb
*.user
*.suo
.vs/
Generated Files/
*.binlog
# Scratch: screenshots, render intermediates, audit output. All regenerable,
# all noise. The ONE exception is the extracted OM10 parts, which are not
# regenerable by anybody here - om10_extract.py reads them out of the 18.8MB
# openmovement STEP, and no machine on this project still has that file. They
# are the source for tools/gltf_export.py and for clash_check, om10_check,
# layout_preview and cad_parts, so losing them would strand both pipelines.
# Git cannot re-include a path under an excluded directory, hence the ladder.
captures/*
!captures/om10/
captures/om10/*
!captures/om10/parts/
__pycache__/

# Installed skill payloads. skills-lock.json pins them; the trees themselves are
# fetched, not authored, and one of them is 6MB.
.agents/
.claude/skills/

# The CAD kernel's virtualenv. cadquery pulls OpenCASCADE and VTK - several
# hundred MB of binary wheels. Recreate with:
#   uv venv .venv-cad --python 3.12 && uv pip install --python .venv-cad cadquery trimesh
.venv-cad/

# Per-source-file CAD generation state: lock files, progress JSON and cached
# component glbs the cad skill's generator writes beside each *.step.py while
# it works. Transient and regenerated on the next run of that file. (Its own
# __pycache__/ is already caught by the rule above.)
models/step/__cadgen__/
