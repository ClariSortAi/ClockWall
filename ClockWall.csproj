<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ClockWall</RootNamespace>
    <AssemblyName>ClockWall</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>

    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- One pinned upload of decoded pixels in Rendering/Gpu.cs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The rendered watch-face assets. Regenerated by tools/, not by the
         build: they need Blender, and a wall clock should not need a renderer
         installed to compile. -->
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />

    <!-- The studio panorama the real-time face lights with, linked from
         where the offline render already keeps it so there is one copy.
         (Assets\movement.glb, the other input, is written there directly by
         tools/gltf_export.py and is covered by the glob above.) -->
    <Content Include="tools\hdri\studio_small_09_2k.hdr" Link="Assets\studio.hdr" CopyToOutputDirectory="PreserveNewest" />

    <!-- Shaders compile from source at start-up, so they ship inside the
         assembly rather than beside it. -->
    <EmbeddedResource Include="Rendering\Shaders\*.hlsl" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.*" />

    <!-- The real-time watch face. Vortice is pure P/Invoke over the system
         d3d11.dll / dxgi.dll and ships no native binary of its own, which is
         the reason it was chosen over the alternatives: Smart App Control is
         enforced on the wall machine and would block an unsigned native DLL
         the same way it blocks a self-contained publish (see CLAUDE.md).
         D3DCompiler binds the Microsoft-signed d3dcompiler_47.dll that ships
         in System32 since Windows 8.1, so shaders compile from source at
         startup and there is no offline shader build step. -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.WinUI" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="SharpGLTF.Core" Version="1.0.6" />
  </ItemGroup>

</Project>
