<UserControl
    x:Class="ClockWall.ActivityTicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        One static line naming what every agent that is working right now is
        doing. The code-behind rewrites it in place on a 1s poll; nothing here
        moves, so there is never a moment when the line has to finish something
        before it can tell the truth.

        The explicit Height is the band MainWindow.PushRosterBudget budgets for,
        and it is the theme's number rather than this file's. A line too wide
        for the wall is trimmed with an ellipsis - the far end of an overlong
        line is worth less than the near end being readable at a glance.
    -->
    <TextBlock x:Name="Line"
               Height="{StaticResource ActivityTickerHeight}"
               Style="{StaticResource ActivityTickerTextStyle}"
               TextAlignment="Center"
               TextTrimming="CharacterEllipsis" />

</UserControl>
