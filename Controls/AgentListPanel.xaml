<!--
    AgentListPanel - the live roster of Claude Code agents running on this
    machine, occupying the lower zone of the 1080x1920 wall.

    Shape notes:
      * A ListView (not a hand-rolled StackPanel of Borders) so the platform
        keeps virtualisation, reorder transitions and recycling. It is NOT
        wrapped in a ScrollViewer - code-behind sizes it to a whole number of
        card rows against the height BUDGET the host measured out for it, so
        nothing is ever half cut, and the remainder is announced in the footer.
      * The panel is CONTENT-SIZED, not stretched: the list row is Auto, so with
        two agents the control is ~500px tall rather than a 900px region with
        400px of dead background in it. The host gives the leftover height to
        the hero instead (see MainWindow.xaml).
      * Every live value binds Mode=OneWay. x:Bind defaults to OneTime, which
        would silently freeze the uptime counters and the status pills.
      * Status is never carried by colour alone: each pill pairs its dot with a
        word, so it survives High Contrast and colour-vision differences.
-->
<UserControl
    x:Class="ClockWall.AgentListPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ClockWall"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!-- One agent. Reads left-to-right as: what state is it in / who is it
             and where / how long has it been like that. -->
        <DataTemplate x:Key="AgentCardTemplate" x:DataType="local:AgentSession">
            <Border Style="{StaticResource AgentCardStyle}">
                <Grid ColumnSpacing="{StaticResource SpacingLarge}">
                    <Grid.ColumnDefinitions>
                        <!-- Fixed-ish status gutter so every pill starts on the
                             same vertical line down the column. -->
                        <ColumnDefinition Width="Auto" MinWidth="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- ==================== STATUS ==================== -->
                    <!-- The three pills overlap; exactly one is visible. Keeping
                         them as separate elements lets every brush stay a
                         {ThemeResource} at its usage site. -->
                    <Grid Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">

                        <Border Style="{StaticResource AgentStatusPillStyle}"
                                Background="{ThemeResource AgentStatusBusyBackgroundBrush}"
                                Visibility="{x:Bind local:AgentListPanel.WhenBusy(Status), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="{StaticResource SpacingSmall}">
                                <!-- Named so the code-behind can breathe it while
                                     busy and stop cleanly on recycle. -->
                                <Ellipse x:Name="BusyDot"
                                         Style="{StaticResource AgentStatusDotStyle}"
                                         Fill="{ThemeResource AgentStatusBusyBrush}" />
                                <TextBlock Style="{StaticResource AgentStatusLabelTextStyle}"
                                           Text="BUSY" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource AgentStatusPillStyle}"
                                Background="{ThemeResource AgentStatusIdleBackgroundBrush}"
                                Visibility="{x:Bind local:AgentListPanel.WhenIdle(Status), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="{StaticResource SpacingSmall}">
                                <Ellipse Style="{StaticResource AgentStatusDotStyle}"
                                         Fill="{ThemeResource AgentStatusIdleBrush}" />
                                <TextBlock Style="{StaticResource AgentStatusLabelTextStyle}"
                                           Text="IDLE" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource AgentStatusPillStyle}"
                                Background="{ThemeResource AgentStatusUnknownBackgroundBrush}"
                                Visibility="{x:Bind local:AgentListPanel.WhenOther(Status), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="{StaticResource SpacingSmall}">
                                <Ellipse Style="{StaticResource AgentStatusDotStyle}"
                                         Fill="{ThemeResource AgentStatusUnknownBrush}" />
                                <TextBlock Style="{StaticResource AgentStatusLabelTextStyle}"
                                           Text="{x:Bind local:AgentListPanel.OtherLabel(Status), Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                    </Grid>

                    <!-- ==================== IDENTITY ==================== -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Style="{StaticResource AgentNameTextStyle}"
                                   Text="{x:Bind DisplayName, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource AgentDetailTextStyle}"
                                   Text="{x:Bind local:AgentListPanel.ProjectLine(ProjectName, Kind), Mode=OneWay}" />
                        <TextBlock Style="{StaticResource AgentMetaTextStyle}"
                                   Text="{x:Bind Cwd, Mode=OneWay}" />
                    </StackPanel>

                    <!-- ==================== TIMINGS ==================== -->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Spacing="{StaticResource SpacingXSmall}">

                        <!-- Four stats across, so the gap between them steps down
                             one notch on the spacing scale: at SpacingLarge the
                             block crowds the agent name out of the identity
                             column and trims it. -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="{StaticResource SpacingMedium}">

                            <StackPanel HorizontalAlignment="Right" MinWidth="84">
                                <TextBlock Style="{StaticResource AgentMetaTextStyle}"
                                           CharacterSpacing="120"
                                           TextAlignment="Right"
                                           Text="UPTIME" />
                                <TextBlock Style="{StaticResource AgentStatusLabelTextStyle}"
                                           TextAlignment="Right"
                                           Text="{x:Bind local:AgentListPanel.Duration(Uptime), Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" MinWidth="100">
                                <TextBlock Style="{StaticResource AgentMetaTextStyle}"
                                           CharacterSpacing="120"
                                           TextAlignment="Right"
                                           Text="{x:Bind local:AgentListPanel.StateCaption(Status), Mode=OneWay}" />
                                <TextBlock Style="{StaticResource AgentStatusLabelTextStyle}"
                                           TextAlignment="Right"
                                           Text="{x:Bind local:AgentListPanel.Duration(SinceStatusChange), Mode=OneWay}" />
                            </StackPanel>

                            <!-- Both figures come from the session TRANSCRIPT, not
                                 the session file, which carries no token data. -->
                            <StackPanel HorizontalAlignment="Right" MinWidth="76">
                                <TextBlock Style="{StaticResource AgentMetaTextStyle}"
                                           CharacterSpacing="120"
                                           TextAlignment="Right"
                                           Text="CONTEXT" />
                                <TextBlock Style="{StaticResource AgentStatusLabelTextStyle}"
                                           TextAlignment="Right"
                                           Text="{x:Bind local:AgentListPanel.ContextShare(ContextTokens), Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" MinWidth="76">
                                <TextBlock Style="{StaticResource AgentMetaTextStyle}"
                                           CharacterSpacing="120"
                                           TextAlignment="Right"
                                           Text="TOKENS" />
                                <TextBlock Style="{StaticResource AgentStatusLabelTextStyle}"
                                           TextAlignment="Right"
                                           Text="{x:Bind local:AgentListPanel.TokenCount(OutputTokens), Mode=OneWay}" />
                            </StackPanel>

                        </StackPanel>

                        <TextBlock Style="{StaticResource AgentMetaTextStyle}"
                                   TextAlignment="Right"
                                   Text="{x:Bind local:AgentListPanel.MetaLine(Version, Pid), Mode=OneWay}" />

                    </StackPanel>

                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid RowSpacing="{StaticResource SpacingMedium}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Auto, not star: the list region is exactly as tall as the cards
                 in it. The height the fitting maths solves against is
                 AgentListPanel.ListBudget - what the HOST measured as left over
                 - not this row, which is the result rather than the input. -->
            <RowDefinition Height="Auto" />
            <!-- Auto: with the panel content-sized, an always-reserved footer
                 band would just deepen the bottom inset from 56px to 106px.
                 The row collapses when there is no overflow to announce. -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== SECTION HEADER ==================== -->
        <Grid Grid.Row="0">
            <TextBlock Style="{StaticResource SectionHeaderTextStyle}"
                       VerticalAlignment="Bottom"
                       Text="AGENTS" />
            <TextBlock x:Name="SummaryText"
                       Style="{StaticResource SectionHeaderTextStyle}"
                       FontSize="{StaticResource AgentStatusLabelFontSize}"
                       Foreground="{ThemeResource AgentMetaTextBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom" />
        </Grid>

        <!-- ==================== LIST / EMPTY STATE ==================== -->
        <Grid x:Name="ListHost" Grid.Row="1">

            <ListView x:Name="AgentListView"
                      ItemsSource="{x:Bind Sessions}"
                      ItemTemplate="{StaticResource AgentCardTemplate}"
                      ItemContainerStyle="{StaticResource AgentListViewItemStyle}"
                      ContainerContentChanging="OnContainerContentChanging"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      IsSwipeEnabled="False"
                      IsTabStop="False"
                      IsHitTestVisible="False"
                      ShowsScrollingPlaceholders="False"
                      Padding="0"
                      VerticalAlignment="Top"
                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

            <!-- Nothing running is a normal, restful state for a wall panel -
                 it gets a considered composition, not an empty rectangle. -->
            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="{StaticResource SpacingMedium}"
                        Visibility="Collapsed">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Glyph="&#xE708;"
                          FontSize="84"
                          HorizontalAlignment="Center"
                          Foreground="{ThemeResource EmptyStateTextBrush}" />
                <TextBlock Style="{StaticResource EmptyStateTextStyle}"
                           Text="No agents running" />
                <TextBlock x:Name="WatchPathText"
                           Style="{StaticResource AgentMetaTextStyle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

        </Grid>

        <!-- ==================== OVERFLOW ==================== -->
        <StackPanel x:Name="OverflowIndicator"
                    Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="{StaticResource SpacingSmall}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                      Glyph="&#xE70D;"
                      FontSize="16"
                      Foreground="{ThemeResource AgentMetaTextBrush}" />
            <TextBlock x:Name="OverflowText"
                       Style="{StaticResource AgentMetaTextStyle}"
                       CharacterSpacing="120"
                       VerticalAlignment="Center" />
        </StackPanel>

    </Grid>
</UserControl>
