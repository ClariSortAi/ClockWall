<!--
    AgentListPanel - the live roster of Claude Code agents running on this
    machine, occupying the lower zone of the 1080x1920 wall.

    Shape notes:
      * A ListView (not a hand-rolled StackPanel of Borders) so the platform
        keeps virtualisation, reorder transitions and recycling. It is NOT
        wrapped in a ScrollViewer - code-behind sizes it to a whole number of
        card rows against the height BUDGET the host measured out for it, so
        nothing is ever half cut, and the remainder is announced in the footer.
      * The panel is CONTENT-SIZED, not stretched: the list row is Auto, so with
        two agents the control is ~500px tall rather than a 900px region with
        400px of dead background in it. The host gives the leftover height to
        the hero instead (see MainWindow.xaml).
      * Every live value binds Mode=OneWay. x:Bind defaults to OneTime, which
        would silently freeze the uptime counters and the status pills.
      * Status is never carried by colour alone: each pill pairs its dot with a
        word, so it survives High Contrast and colour-vision differences.
-->
<UserControl
    x:Class="ClockWall.AgentListPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ClockWall"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!-- One row, in one of two shapes: the full card for a SESSION, and a
             compact indented line for a SUBAGENT running inside one. Exactly one
             of the two is visible, chosen by IsChild - which is cheaper than a
             DataTemplateSelector and keeps both shapes in one place, where the
             indent that relates them is easy to see.

             The card reads left-to-right as: what state is it in / who is it and
             where / how long has it been like that. -->
        <DataTemplate x:Key="AgentCardTemplate" x:DataType="local:AgentSession">
          <Grid>
            <Border Style="{StaticResource AgentCardStyle}"
                    Visibility="{x:Bind local:AgentListPanel.WhenParent(IsChild)}">
                <Grid ColumnSpacing="{StaticResource SpacingLarge}">
                    <Grid.ColumnDefinitions>
                        <!-- Fixed-ish status gutter so every pill starts on the
                             same vertical line down the column. -->
                        <ColumnDefinition Width="Auto" MinWidth="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- ==================== STATUS ==================== -->
                    <!-- The three pills overlap; exactly one is visible. Keeping
                         them as separate elements lets every brush stay a
                         {ThemeResource} at its usage site. -->
                    <StackPanel Grid.Column="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Spacing="{StaticResource SpacingSmall}">

                    <Grid HorizontalAlignment="Left">

                        <Border Style="{StaticResource AgentStatusPillStyle}"
                                Background="{ThemeResource AgentStatusBusyBackgroundBrush}"
                                Visibility="{x:Bind local:AgentListPanel.WhenBusy(Status), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="{StaticResource SpacingSmall}">
                                <!-- Named so the code-behind can breathe it while
                                     busy and stop cleanly on recycle. -->
                                <Ellipse x:Name="BusyDot"
                                         Style="{StaticResource AgentStatusDotStyle}"
                                         Fill="{ThemeResource AgentStatusBusyBrush}" />
                                <TextBlock Style="{StaticResource AgentStatusLabelTextStyle}"
                                           Text="BUSY" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource AgentStatusPillStyle}"
                                Background="{ThemeResource AgentStatusIdleBackgroundBrush}"
                                Visibility="{x:Bind local:AgentListPanel.WhenIdle(Status), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="{StaticResource SpacingSmall}">
                                <Ellipse Style="{StaticResource AgentStatusDotStyle}"
                                         Fill="{ThemeResource AgentStatusIdleBrush}" />
                                <TextBlock Style="{StaticResource AgentStatusLabelTextStyle}"
                                           Text="IDLE" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource AgentStatusPillStyle}"
                                Background="{ThemeResource AgentStatusUnknownBackgroundBrush}"
                                Visibility="{x:Bind local:AgentListPanel.WhenOther(Status), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="{StaticResource SpacingSmall}">
                                <Ellipse Style="{StaticResource AgentStatusDotStyle}"
                                         Fill="{ThemeResource AgentStatusUnknownBrush}" />
                                <TextBlock Style="{StaticResource AgentStatusLabelTextStyle}"
                                           Text="{x:Bind local:AgentListPanel.OtherLabel(Status), Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                    </Grid>

                        <!-- The session's subagents, running over spawned. It
                             says the same thing whether or not any child rows
                             fitted underneath, which is what a session running a
                             dozen of them has instead of a tree.

                             It lives in the status gutter, under the pill,
                             because that column is 150px wide for the pill's
                             sake and otherwise empty: a fifth stat column would
                             have cost the agent NAME a hundred pixels on every
                             card, subagents or not. Collapsed when none are
                             running, so a session with no subagents is the card
                             it always was. -->
                        <TextBlock Style="{StaticResource AgentMetaTextStyle}"
                                   Margin="4,0,0,0"
                                   Visibility="{x:Bind local:AgentListPanel.WhenPositive(SubagentLiveCount), Mode=OneWay}"
                                   Text="{x:Bind local:AgentListPanel.SubagentTally(SubagentLiveCount, SubagentCount), Mode=OneWay}" />

                    </StackPanel>

                    <!-- ==================== IDENTITY ==================== -->
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Style="{StaticResource AgentNameTextStyle}"
                                   Text="{x:Bind DisplayName, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource AgentDetailTextStyle}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{x:Bind local:AgentListPanel.ProjectLine(ProjectName, Kind), Mode=OneWay}" />
                        <TextBlock Style="{StaticResource AgentMetaTextStyle}"
                                   Text="{x:Bind Cwd, Mode=OneWay}" />
                    </StackPanel>

                    <!-- ==================== TIMINGS ==================== -->
                    <StackPanel Grid.Column="2"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Spacing="{StaticResource SpacingXSmall}">

                        <!-- Four stats across, so the gap between them steps down
                             one notch on the spacing scale: at SpacingLarge the
                             block crowds the agent name out of the identity
                             column and trims it. -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="{StaticResource SpacingMedium}">

                            <StackPanel HorizontalAlignment="Right" MinWidth="84">
                                <TextBlock Style="{StaticResource AgentMetaTextStyle}"
                                           CharacterSpacing="120"
                                           TextAlignment="Right"
                                           Text="UPTIME" />
                                <TextBlock Style="{StaticResource AgentStatusLabelTextStyle}"
                                           TextAlignment="Right"
                                           Text="{x:Bind local:AgentListPanel.Duration(Uptime), Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" MinWidth="100">
                                <TextBlock Style="{StaticResource AgentMetaTextStyle}"
                                           CharacterSpacing="120"
                                           TextAlignment="Right"
                                           Text="{x:Bind local:AgentListPanel.StateCaption(Status), Mode=OneWay}" />
                                <TextBlock Style="{StaticResource AgentStatusLabelTextStyle}"
                                           TextAlignment="Right"
                                           Text="{x:Bind local:AgentListPanel.Duration(SinceStatusChange), Mode=OneWay}" />
                            </StackPanel>

                            <!-- Both figures come from the session TRANSCRIPT, not
                                 the session file, which carries no token data.

                                 The context value tints as the window fills -
                                 caution from 75%, critical from 90% (the
                                 auto-compact neighbourhood): three overlapped
                                 TextBlocks, exactly one visible, same pattern
                                 as the status pills so every brush stays a
                                 ThemeResource at its usage site.

                                 A session whose window we cannot establish
                                 shows a raw token count in the calm register
                                 instead of a percentage - see ContextShare. -->
                            <StackPanel HorizontalAlignment="Right" MinWidth="76">
                                <TextBlock Style="{StaticResource AgentMetaTextStyle}"
                                           CharacterSpacing="120"
                                           TextAlignment="Right"
                                           Text="CONTEXT" />
                                <Grid HorizontalAlignment="Right">
                                    <TextBlock Style="{StaticResource AgentStatusLabelTextStyle}"
                                               TextAlignment="Right"
                                               Visibility="{x:Bind local:AgentListPanel.WhenContextCalm(ContextTokens, ContextWindowKnown), Mode=OneWay}"
                                               Text="{x:Bind local:AgentListPanel.ContextShare(ContextTokens, ContextWindowKnown), Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource AgentStatusLabelTextStyle}"
                                               TextAlignment="Right"
                                               Foreground="{ThemeResource ContextCautionTextBrush}"
                                               Visibility="{x:Bind local:AgentListPanel.WhenContextCaution(ContextTokens, ContextWindowKnown), Mode=OneWay}"
                                               Text="{x:Bind local:AgentListPanel.ContextShare(ContextTokens, ContextWindowKnown), Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource AgentStatusLabelTextStyle}"
                                               TextAlignment="Right"
                                               Foreground="{ThemeResource ContextCriticalTextBrush}"
                                               Visibility="{x:Bind local:AgentListPanel.WhenContextCritical(ContextTokens, ContextWindowKnown), Mode=OneWay}"
                                               Text="{x:Bind local:AgentListPanel.ContextShare(ContextTokens, ContextWindowKnown), Mode=OneWay}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" MinWidth="76">
                                <TextBlock Style="{StaticResource AgentMetaTextStyle}"
                                           CharacterSpacing="120"
                                           TextAlignment="Right"
                                           Text="TOKENS" />
                                <TextBlock Style="{StaticResource AgentStatusLabelTextStyle}"
                                           TextAlignment="Right"
                                           Text="{x:Bind local:AgentListPanel.TokenCount(OutputTokens), Mode=OneWay}" />
                            </StackPanel>

                        </StackPanel>

                        <TextBlock Style="{StaticResource AgentMetaTextStyle}"
                                   TextAlignment="Right"
                                   Text="{x:Bind local:AgentListPanel.MetaLine(Model, Version, Pid, TokensPerSecond, ToolsPerMinute), Mode=OneWay}" />

                    </StackPanel>

                </Grid>
            </Border>

            <!-- ==================== SUBAGENT ROW ====================
                 One line, no card, inset past the parent's status gutter and
                 set in the two smallest sizes on the ramp: subordinate at a
                 glance, from across a room, without needing to be read. It does
                 NOT mirror the card's stat columns - those are already tight,
                 and a child has less to say. -->
            <Grid Visibility="{x:Bind local:AgentListPanel.WhenChild(IsChild)}"
                  Margin="72,0,24,0"
                  VerticalAlignment="Center"
                  ColumnSpacing="{StaticResource SpacingMedium}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Style="{StaticResource AgentMetaTextStyle}"
                           VerticalAlignment="Center"
                           Text="&#x21B3;" />

                <!-- The name is what the agent was spawned to do, so it gets the
                     room; capped so a long one cannot crowd out everything else. -->
                <TextBlock Grid.Column="1"
                           Style="{StaticResource AgentDetailTextStyle}"
                           VerticalAlignment="Center"
                           MaxWidth="420"
                           TextTrimming="CharacterEllipsis"
                           Text="{x:Bind DisplayName, Mode=OneWay}" />

                <TextBlock Grid.Column="2"
                           Style="{StaticResource AgentMetaTextStyle}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{x:Bind Activity, Mode=OneWay}" />

                <TextBlock Grid.Column="3"
                           Style="{StaticResource AgentMetaTextStyle}"
                           VerticalAlignment="Center"
                           TextAlignment="Right"
                           Text="{x:Bind local:AgentListPanel.ChildStats(ContextTokens, ContextWindowKnown, OutputTokens, Model), Mode=OneWay}" />
            </Grid>

            <!-- ==================== ATTENTION GLOW ====================
                 An accent outline over the whole card, in two registers:
                 FLASHING (code-behind storyboard) while the session is
                 "waiting" - blocked on the user, burning wall-clock - and
                 STEADY for the first minutes after a session stops being
                 busy, so "did it finish while I was away?" is answered from
                 the doorway. Never on a subagent row, which has no card. -->
            <Border x:Name="AttentionGlow"
                    IsHitTestVisible="False"
                    BorderBrush="{ThemeResource WallAccentBrush}"
                    BorderThickness="3"
                    CornerRadius="{StaticResource AgentCardCornerRadius}"
                    Visibility="{x:Bind local:AgentListPanel.WhenAttention(IsChild, Status, SinceStatusChange), Mode=OneWay}" />
          </Grid>
        </DataTemplate>

    </UserControl.Resources>

    <Grid RowSpacing="{StaticResource SpacingMedium}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Auto, not star: the list region is exactly as tall as the cards
                 in it. The height the fitting maths solves against is
                 AgentListPanel.ListBudget - what the HOST measured as left over
                 - not this row, which is the result rather than the input. -->
            <RowDefinition Height="Auto" />
            <!-- Auto: with the panel content-sized, an always-reserved footer
                 band would just deepen the bottom inset from 56px to 106px.
                 The row collapses when there is no overflow to announce. -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== SECTION HEADER ====================
             Two right-aligned lines, not one: the day totals ride a small
             line of their own above the roster counts, because the two
             together grew long enough to run into the AGENTS label. -->
        <Grid Grid.Row="0">
            <TextBlock Style="{StaticResource SectionHeaderTextStyle}"
                       VerticalAlignment="Bottom"
                       Text="AGENTS" />
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Spacing="{StaticResource SpacingXSmall}">
                <TextBlock x:Name="BurnText"
                           Style="{StaticResource AgentMetaTextStyle}"
                           CharacterSpacing="120"
                           HorizontalAlignment="Right" />
                <TextBlock x:Name="SummaryText"
                           Style="{StaticResource SectionHeaderTextStyle}"
                           FontSize="{StaticResource AgentStatusLabelFontSize}"
                           Foreground="{ThemeResource AgentMetaTextBrush}"
                           HorizontalAlignment="Right" />
            </StackPanel>
        </Grid>

        <!-- ==================== LIST / EMPTY STATE ==================== -->
        <Grid x:Name="ListHost" Grid.Row="1">

            <ListView x:Name="AgentListView"
                      ItemsSource="{x:Bind Sessions}"
                      ItemTemplate="{StaticResource AgentCardTemplate}"
                      ItemContainerStyle="{StaticResource AgentListViewItemStyle}"
                      ContainerContentChanging="OnContainerContentChanging"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      IsSwipeEnabled="False"
                      IsTabStop="False"
                      IsHitTestVisible="False"
                      ShowsScrollingPlaceholders="False"
                      Padding="0"
                      VerticalAlignment="Top"
                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <!-- The roster REORDERS - a session that starts waiting is
                     Moved to the top, which is this panel's signature state
                     change - and rows are added and removed as sessions start
                     and end. A row that teleports into its new slot is a row
                     the viewer has to find and identify again from across the
                     room; a row that glides is visibly the SAME row, still
                     being followed. That spatial continuity is not decoration,
                     it IS the information, which is what buys the reposition
                     its ~300ms on the system curve. AddDeleteThemeTransition
                     covers the other half, so a session arriving or leaving is
                     a movement rather than a blink.

                     Staggering is off: the roster settling is not a reveal
                     moment, and a cascade down a column of cards would dress up
                     what is really one simultaneous fact - the order changed.

                     Declaring the collection REPLACES the platform default set,
                     which is the point. These two are the whole chosen set, so
                     what the wall does on a reorder stops being whatever the
                     default happened to be in that release. Unlike the busy
                     breath and the needs-you flash, which the code-behind gates
                     on the OS animation-effects setting, both of these are brief
                     one-shots that never loop, so they are left to the platform.

                     Worth confirming on the wall rather than assuming: the docs
                     say RepositionThemeTransition is not DESIGNED for a
                     virtualising panel, and a ListView's default ItemsStackPanel
                     is one - though this list never scrolls (it is sized to a
                     whole number of rows) so it recycles only when the roster
                     itself changes. -->
                <ListView.ItemContainerTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition IsStaggeringEnabled="False" />
                        <AddDeleteThemeTransition />
                    </TransitionCollection>
                </ListView.ItemContainerTransitions>

            </ListView>

            <!-- Nothing running is a normal, restful state for a wall panel -
                 it gets a considered composition, not an empty rectangle. -->
            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="{StaticResource SpacingMedium}"
                        Visibility="Collapsed">
                <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          Glyph="&#xE708;"
                          FontSize="84"
                          HorizontalAlignment="Center"
                          Foreground="{ThemeResource EmptyStateTextBrush}" />
                <TextBlock Style="{StaticResource EmptyStateTextStyle}"
                           Text="No agents running" />
                <TextBlock x:Name="WatchPathText"
                           Style="{StaticResource AgentMetaTextStyle}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

        </Grid>

        <!-- ==================== OVERFLOW ==================== -->
        <StackPanel x:Name="OverflowIndicator"
                    Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="{StaticResource SpacingSmall}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                      Glyph="&#xE70D;"
                      FontSize="16"
                      Foreground="{ThemeResource AgentMetaTextBrush}" />
            <TextBlock x:Name="OverflowText"
                       Style="{StaticResource AgentMetaTextStyle}"
                       CharacterSpacing="120"
                       VerticalAlignment="Center" />
        </StackPanel>

    </Grid>
</UserControl>
