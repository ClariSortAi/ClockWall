<UserControl
    x:Class="ClockWall.StudioStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The studio's seven numbers, as a strip above the live face: a caption
        in the wall's small type, a slider, the value in white under it.
        Every value is a physical quantity (Rendering/Lighting.cs) and each
        slider's scale comes from there too - the amounts of light run in
        stops, the angles and the temperature in their own units - so what a
        drag means is decided next to the physics. The keys still work and
        the sliders follow them. The sliders are WinUI's own, restyled in the
        wall's white through Theme.xaml's resource keys.

        The wall's root is the window's drag region, which swallows pointer
        input; MainWindow cuts a passthrough hole for this strip's bounds so
        the chevrons can be tapped at all. See StudioBoundsChanged.
    -->
    <StackPanel HorizontalAlignment="Center" Spacing="{StaticResource SpacingSmall}">
        <!-- The toggle: one word in the caption type. Tapped, or the L key,
             shows the sliders or puts them away; the wall runs with them
             away, and they are there when somebody wants to move a light. -->
        <TextBlock x:Name="Toggle"
                   Style="{StaticResource StudioCaptionTextStyle}"
                   HorizontalAlignment="Center"
                   Padding="{StaticResource StudioTogglePadding}"
                   Text="STUDIO  ▸" />
        <StackPanel x:Name="Root"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="{StaticResource SpacingSmall}"
                    Visibility="Collapsed" />
    </StackPanel>

</UserControl>
